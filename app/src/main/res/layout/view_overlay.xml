<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Ball: bottom-right when collapsed, bottom-center when expanded -->
    <FrameLayout
        android:id="@+id/orbHost"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp">

        <com.aero.voice.OrbView
            android:id="@+id/overlayOrb"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Expanded bottom bar: camera | screen share | (ball) | mic | cross -->
    <LinearLayout
        android:id="@+id/expandedPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="invisible">

        <ImageButton
            android:id="@+id/overlayCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_overlay_button"
            android:elevation="4dp"
            android:src="@drawable/ic_video"
            android:tint="@android:color/white"
            android:contentDescription="@string/live_desc" />

        <ImageButton
            android:id="@+id/overlayScreenToggle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_overlay_button"
            android:elevation="4dp"
            android:src="@drawable/ic_screen_share"
            android:tint="@android:color/white"
            android:contentDescription="@string/screen_share_desc" />

        <!-- Space where the centred ball sits -->
        <View
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/overlayMute"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_overlay_button"
            android:elevation="4dp"
            android:src="@drawable/ic_mic"
            android:tint="@android:color/white"
            android:contentDescription="@string/mute_desc" />

        <ImageButton
            android:id="@+id/overlayClose"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_overlay_button"
            android:elevation="4dp"
            android:src="@drawable/ic_close"
            android:tint="@android:color/white"
            android:contentDescription="@string/settings_desc" />
    </LinearLayout>
</FrameLayout>
