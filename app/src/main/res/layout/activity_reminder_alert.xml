<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_screen"
    android:fitsSystemWindows="true">

    <!-- ================= INCOMING CALL (real dialer style) ================= -->
    <LinearLayout
        android:id="@+id/incomingGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp">

            <View
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/bg_call_avatar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="A"
                android:textColor="#E6EBF2"
                android:textSize="42sp"
                android:textStyle="normal" />
        </FrameLayout>

        <TextView
            android:id="@+id/reminderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-medium"
            android:text="Aero"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/reminderSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.04"
            android:text="Incoming call"
            android:textColor="#96A2B3"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/reminderMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="2"
            android:text=""
            android:textColor="#C6CFDA"
            android:textSize="15sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="44dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/reminderClose"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_round_red"
                    android:contentDescription="Decline call"
                    android:padding="22dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_phone_down" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif"
                    android:text="Decline"
                    android:textColor="#9AA5B4"
                    android:textSize="13sp" />
            </LinearLayout>

            <Space
                android:layout_width="72dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/reminderAnswer"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_round_green"
                    android:contentDescription="Answer call"
                    android:padding="22dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_phone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif"
                    android:text="Answer"
                    android:textColor="#9AA5B4"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= IN CALL (real dialer style) ================= -->
    <LinearLayout
        android:id="@+id/inCallGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:visibility="gone">

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp">

            <View
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_call_avatar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="A"
                android:textColor="#E6EBF2"
                android:textSize="34sp" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="Aero"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/callTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.1"
            android:text="00:00"
            android:textColor="#96A2B3"
            android:textSize="15sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/callMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="1"
            android:text=""
            android:textColor="#8B97A8"
            android:textSize="14sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnSpeaker"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_call_button"
                    android:contentDescription="Speaker"
                    android:padding="19dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_speaker" />

                <TextView
                    android:id="@+id/labelSpeaker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:fontFamily="sans-serif"
                    android:text="Speaker"
                    android:textColor="#9AA5B4"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnMute"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_call_button"
                    android:contentDescription="Mute microphone"
                    android:padding="19dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_mic_off" />

                <TextView
                    android:id="@+id/labelMute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:fontFamily="sans-serif"
                    android:text="Mute"
                    android:textColor="#9AA5B4"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnReminder"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_call_button"
                    android:contentDescription="Set a reminder"
                    android:padding="19dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_alarm" />

                <TextView
                    android:id="@+id/labelReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:fontFamily="sans-serif"
                    android:text="Reminder"
                    android:textColor="#9AA5B4"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/callHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif"
            android:text="Seedha bolo — jaise &quot;5 baje ki reminder laga do&quot;"
            android:textColor="#5F6B7C"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="40dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnEnd"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_round_red"
                android:contentDescription="End call"
                android:padding="22dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_phone_down" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif"
                android:text="End call"
                android:textColor="#9AA5B4"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
