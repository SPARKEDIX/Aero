<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_screen"
    android:fitsSystemWindows="true">

    <!-- ================= INCOMING CALL ================= -->
    <LinearLayout
        android:id="@+id/incomingGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.14"
            android:text="INCOMING AERO CALL"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="18dp">

            <View
                android:id="@+id/avatarPulse"
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:layout_gravity="center"
                android:alpha="0.35"
                android:background="@drawable/bg_call_avatar" />

            <View
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_call_avatar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="A"
                android:textColor="#FFFFFFFF"
                android:textSize="62sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/reminderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Aero"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reminderSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Incoming call…"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/reminderMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:maxLines="4"
            android:ellipsize="end"
            android:text=""
            android:textColor="#E6FFFFFF"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/reminderClose"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_round_red"
                    android:contentDescription="Decline call"
                    android:padding="20dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_phone_down" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Decline"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="72dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/reminderAnswer"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_round_green"
                    android:contentDescription="Answer call"
                    android:padding="20dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_phone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Answer"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= IN CALL ================= -->
    <LinearLayout
        android:id="@+id/inCallGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aero"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/callTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.08"
            android:text="00:00"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="164dp"
            android:layout_height="164dp"
            android:layout_marginTop="20dp">

            <View
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_call_avatar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="A"
                android:textColor="#FFFFFFFF"
                android:textSize="50sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/callMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text=""
            android:textColor="#D9FFFFFF"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnSpeaker"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_call_button"
                    android:contentDescription="Speaker"
                    android:padding="17dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_speaker" />

                <TextView
                    android:id="@+id/labelSpeaker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Speaker"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnMute"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_call_button"
                    android:contentDescription="Mute microphone"
                    android:padding="17dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_mic_off" />

                <TextView
                    android:id="@+id/labelMute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Mute"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnReminder"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_call_button"
                    android:contentDescription="Set a reminder"
                    android:padding="17dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_alarm" />

                <TextView
                    android:id="@+id/labelReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Reminder"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnEnd"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_round_red"
                android:contentDescription="End call"
                android:padding="20dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_phone_down" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="End call"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/callHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Seedha bolo — jaise &quot;5 baje ki reminder laga do&quot;"
            android:textColor="#80FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
