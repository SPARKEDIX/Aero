<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- Centered cloud orb -->
    <com.aero.voice.OrbView
        android:id="@+id/orbView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Single settings button -->
    <ImageView
        android:id="@+id/settingsButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_circle_white"
        android:elevation="6dp"
        android:src="@drawable/ic_tune"
        android:padding="16dp"
        android:contentDescription="@string/settings_desc" />

    <!-- Mic + animated side actions (fixed width: mic never moves) -->
    <LinearLayout
        android:id="@+id/actionsRow"
        android:layout_width="336dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="56dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/leftActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="invisible"
            android:scaleX="0"
            android:scaleY="0">

            <ImageButton
                android:id="@+id/screenShareButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_circle_white"
                android:elevation="4dp"
                android:src="@drawable/ic_screen_share"
                android:contentDescription="@string/screen_share_desc" />

            <ImageButton
                android:id="@+id/liveButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_circle_white"
                android:elevation="4dp"
                android:src="@drawable/ic_video"
                android:contentDescription="@string/live_desc" />

            <!-- flip button lives inside the camera window (top-left) -->
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/micButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:elevation="8dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.AeroVoice.Circle"
            app:backgroundTint="@color/bg_circle"
            app:tint="@color/text_dark"
            app:srcCompat="@drawable/ic_mic"
            app:fabCustomSize="64dp"
            app:maxImageSize="26dp"
            android:contentDescription="@string/mic_desc" />

        <LinearLayout
            android:id="@+id/rightActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="invisible"
            android:scaleX="0"
            android:scaleY="0">

            <ImageButton
                android:id="@+id/muteButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_circle_white"
                android:elevation="4dp"
                android:src="@drawable/ic_mic"
                android:contentDescription="@string/mute_desc" />

            <ImageButton
                android:id="@+id/attachButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_circle_white"
                android:elevation="4dp"
                android:src="@drawable/ic_plus"
                android:contentDescription="@string/attach_desc" />


        </LinearLayout>
    </LinearLayout>
    <!-- Mini orb visible inside the app while screen sharing -->
    <FrameLayout
        android:id="@+id/miniOrb"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:visibility="gone">

        <com.aero.voice.OrbView
            android:id="@+id/miniOrbView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Live camera window: replaces the orb while sharing -->
    <FrameLayout
        android:id="@+id/cameraWindow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="48dp"
        android:layout_marginBottom="150dp"
        android:background="@drawable/bg_camera_window"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:scaleX="0"
        android:scaleY="0"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/cameraFlipButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_circle_white"
            android:elevation="4dp"
            android:src="@drawable/ic_flip"
            android:contentDescription="@string/flip_desc" />

        <ImageButton
            android:id="@+id/cameraCloseButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_circle_white"
            android:elevation="4dp"
            android:src="@drawable/ic_stop"
            android:contentDescription="@string/live_desc" />
    </FrameLayout>
</FrameLayout>
