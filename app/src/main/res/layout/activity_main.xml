<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- Centered cloud orb -->
    <com.aero.voice.OrbView
        android:id="@+id/orbView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Single settings button (top-right sliders pill) -->
    <ImageView
        android:id="@+id/settingsButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:background="@drawable/bg_circle_white"
        android:elevation="6dp"
        android:src="@drawable/ic_tune"
        android:padding="16dp"
        android:contentDescription="@string/settings_desc" />

    <!-- Circular mic, bottom center -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/micButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="56dp"
        android:elevation="10dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.AeroVoice.Circle"
        app:backgroundTint="@color/bg_circle"
        app:tint="@color/text_dark"
        app:srcCompat="@drawable/ic_mic"
        android:contentDescription="@string/mic_desc" />
</FrameLayout>
