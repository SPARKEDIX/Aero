<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#0B0E15"
                android:centerColor="#0E131C"
                android:endColor="#0B0E15" />
        </shape>
    </item>
    <item
        android:width="420dp"
        android:height="420dp"
        android:gravity="center|top"
        android:top="70dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="210dp"
                android:startColor="#2219C37D"
                android:centerColor="#123D8BFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
